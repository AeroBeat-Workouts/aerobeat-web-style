{
  "name": "@aerobeat/web-style",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./aero-theme.css": "./src/aero-theme.css"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE.md",
    "docs/decisions/"
  ],
  "scripts": {
    "check": "npm run check:jsdoc && npm run check:imports && npm run check:components && npm run check:console && npm run check:visual-tokens",
    "check:jsdoc": "node scripts/validate-jsdoc-no-any.js",
    "check:imports": "node scripts/validate-public-imports.js",
    "check:components": "node scripts/validate-component-rules.js",
    "check:console": "node scripts/validate-playwright-console-noise.js",
    "check:visual-tokens": "node scripts/validate-gameplay-visual-tokens.js",
    "test": "npm run check",
    "test:browser": "npm run check:console && node scripts/validate-browser-visual-tokens.js",
    "demo": "npm --prefix .testbed run demo",
    "testbed:serve": "npm --prefix .testbed run serve",
    "testbed:link-self": "node scripts/link-testbed-self.js"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
